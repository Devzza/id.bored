# ---------- bored.works DApp — environment variables ----------
# Copy this file to `.env.local` and fill in your values. NEVER commit `.env.local`.

# ---- Privy ----
# Privy App ID (must match the one used by the rest of the bored.works stack).
NEXT_PUBLIC_PRIVY_APP_ID=cmu9tg1xh00rs0dl53h011pgt

# ---- Thirdweb v5 ----
# Client ID from https://dashboard.thirdweb.com
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=b87bf115d95b5bb8b5c8920c401d185c

# ---- BoredDomains contract (UUPS proxy) ----
# Address of the deployed BoredDomains contract (BoredDomainsV0 / V2).
# Both env vars are supported; NEXT_PUBLIC_BORED_DOMAINS_ADDRESS takes precedence.
NEXT_PUBLIC_BORED_DOMAINS_ADDRESS=0xb49059c50869b8ce11cD2002b79ffEa31A16A9df
# (legacy) NEXT_PUBLIC_REGISTRY_ADDRESS=<same address>

# ---- Relayer (gasless) ----
# Private key of the relayer wallet that pays gas on behalf of users.
# NEVER expose this to the client. Keep it server-side only.
RELAYER_PRIVATE_KEY=

# ---- Network ----
# "amoy" (Polygon Amoy testnet) | "apechain-testnet" | "apechain" | "polygon"
NEXT_PUBLIC_CHAIN=amoy

# Native token symbol (informational, used in the UI).
NEXT_PUBLIC_NATIVE_SYMBOL=POL

# Block explorer for transaction links.
NEXT_PUBLIC_EXPLORER_URL=
